# Copy this file to ".env" and edit. The ".env" file is never committed.

PORT=3000

# Secret used to sign login tokens. Use a long random string in production.
# (If left empty, a random secret is created once and kept in backend/data/.jwt-secret)
JWT_SECRET=

# First admin user, created by:  npm run seed
# If ADMIN_PASSWORD is empty, a random password is generated and printed once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Only needed if the frontend is hosted on a different address than this server.
CORS_ORIGIN=
