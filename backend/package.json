{
  "name": "odop-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API for the ODOP Catalogue Maker: login, saved catalogues, duplicate check, Excel export. Also serves the frontend.",
  "main": "src/server.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed-admin.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  }
}
