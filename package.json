{
  "name": "odop-catalogue-maker",
  "version": "1.0.0",
  "private": true,
  "description": "ODOP Catalogue Maker: frontend (plain HTML/CSS/JS) + backend (Node.js)",
  "scripts": {
    "setup": "npm --prefix backend install",
    "predev": "node scripts/ensure-install.js",
    "dev": "npm --prefix backend run dev",
